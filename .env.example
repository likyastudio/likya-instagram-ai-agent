# 1. Meta / Instagram Graph API
IG_PAGE_ACCESS_TOKEN=EAA...your_page_access_token_here
IG_ACCOUNT_ID=17841425616032125
IG_USERNAME=likyastudios
IG_APP_SECRET=
IG_VERIFY_TOKEN=
IG_GRAPH_VERSION=v21.0

# 2. Google Gemini (doğrudan gelen DM'ler için)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 3. Panel girişi — Google ile (önerilen). Üçü de doluysa PIN devre dışı kalır.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
ADMIN_EMAILS=ornek@gmail.com
SESSION_SECRET=   # en az 32 karakterlik rastgele değer
# Google ayarlanmamışsa yedek PIN
ADMIN_PIN=

# 4. Takipçi sayfaları ve kalıcı kayıt
PUBLIC_BASE_URL=https://link.likyastudios.live
DATA_BUCKET=      # Cloud Storage kova adı; boşsa yerel dosya (yalnızca geliştirme)
